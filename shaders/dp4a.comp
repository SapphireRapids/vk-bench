// dp4a.comp -- packed int8 dot product (4x8 -> 32) throughput.
// One dotPacked4x8AccSatEXT() is a single DP4A-class instruction: 4 int8 MACs.
#version 450
#extension GL_EXT_integer_dot_product : require

#define STEP(a) a = dotPacked4x8AccSatEXT(p, q, a)
#define B8 STEP(a0); STEP(a1); STEP(a2); STEP(a3); STEP(a4); STEP(a5); STEP(a6); STEP(a7);
#define BODY B8 B8 B8 B8

layout(local_size_x = 128) in;
layout(constant_id = 0) const uint ITERS = 1024;
layout(push_constant) uniform PC { uint seed; } pc;
layout(std430, binding = 0) writeonly buffer Out { uint o[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint p = 0x01020304u ^ (gid * 2654435761u) ^ pc.seed;
    uint q = 0x07060504u + gid * 40503u;
    uint a0 = p, a1 = q, a2 = p ^ q, a3 = p + q;
    uint a4 = p * 3u + 1u, a5 = q * 5u + 3u, a6 = p ^ (q << 3u), a7 = q ^ (p >> 5u);

    for (uint i = 0u; i < ITERS; ++i) {
        BODY
    }

    o[gid] = a0 ^ a1 ^ a2 ^ a3 ^ a4 ^ a5 ^ a6 ^ a7;
}
