// subgroup.comp -- subgroup operation throughput in compute.
// -DSG_OP: 0 = subgroupAdd (reduction), 1 = subgroupShuffle, 2 = subgroupBallot,
//          3 = shared-memory round trip with barrier (per-group sync cost)
#version 450

#ifndef SG_OP
#define SG_OP 0
#endif

#if SG_OP == 0
#extension GL_KHR_shader_subgroup_arithmetic : require
#elif SG_OP == 1
#extension GL_KHR_shader_subgroup_shuffle : require
#elif SG_OP == 2
#extension GL_KHR_shader_subgroup_ballot : require
#endif

layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITERS = 1024;
layout(push_constant) uniform PC { uint seed; } pc;
layout(std430, binding = 0) writeonly buffer Out { float o[]; };

#if SG_OP == 3
shared float smem[64];
#endif

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint tid = gl_LocalInvocationID.x;
    uint v = gid * 2654435761u ^ pc.seed;
    float f = 1.0 + float(gid & 255u) * 1e-3;

    for (uint i = 0u; i < ITERS; ++i) {
#if SG_OP == 0
        v = subgroupAdd(v);
#elif SG_OP == 1
        v = subgroupShuffle(v, 1u);
#elif SG_OP == 2
        v = subgroupBallot((v & 1u) != 0u).x;
#else
        smem[tid] = f;
        barrier();
        f = smem[(tid + 1u) & 63u] + f * 1e-9;
        barrier();
#endif
    }

#if SG_OP == 3
    o[gid] = f + float(v % 1000u);
#else
    o[gid] = float(v % 1000000u);
#endif
}
