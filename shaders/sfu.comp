// sfu.comp -- transcendental / special-function unit throughput.
// -DSFU_OP: 0 = sin, 1 = exp2, 2 = log2, 3 = inversesqrt, 4 = sqrt, 5 = cos
// 8 independent chains; values may saturate (inf/0) after many iterations, which does not
// change the instruction count -- we measure throughput, not accuracy.
#version 450

#ifndef SFU_OP
#define SFU_OP 0
#endif

#if SFU_OP == 0
#define FN(x) sin(x)
#elif SFU_OP == 1
// exp2 grows without bound; exp2(-x) keeps the chain in a finite range on purpose.
#define FN(x) exp2(-x)
#elif SFU_OP == 2
#define FN(x) log2(abs(x) + 1.5)
#elif SFU_OP == 3
#define FN(x) inversesqrt(abs(x) + 0.5)
#elif SFU_OP == 4
#define FN(x) sqrt(abs(x) + 0.5)
#else
#define FN(x) cos(x)
#endif

#define B8 x0 = FN(x0); x1 = FN(x1); x2 = FN(x2); x3 = FN(x3); \
           x4 = FN(x4); x5 = FN(x5); x6 = FN(x6); x7 = FN(x7);
#define BODY B8 B8 B8 B8

layout(local_size_x = 128) in;
layout(constant_id = 0) const uint ITERS = 1024;
layout(push_constant) uniform PC { float seed; uint pad; } pc;
layout(std430, binding = 0) writeonly buffer Out { float o[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    float s = pc.seed;
    float x0 = 1.0 + s + float(gid & 3u) * 0.125;
    float x1 = 1.1 + s + float(gid & 7u) * 0.0625;
    float x2 = 1.2 + s + float(gid & 15u) * 0.03125;
    float x3 = 1.3 + s + float(gid & 31u) * 0.015625;
    float x4 = 1.4 + s + float(gid & 63u) * 0.0078125;
    float x5 = 1.5 + s + float(gid & 127u) * 0.00390625;
    float x6 = 1.6 + s + float(gid & 255u) * 0.001953125;
    float x7 = 1.7 + s + float(gid & 511u) * 0.0009765625;

    for (uint i = 0u; i < ITERS; ++i) {
        BODY
    }

    o[gid] = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7;
}
